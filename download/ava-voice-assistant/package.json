{
  "name": "ava-voice-assistant",
  "productName": "AVA Voice Assistant",
  "version": "0.4.0",
  "description": "آوا — دستیار صوتی ویندوز | نسخه ۰.۴ با آپدیت خودکار، پاسخ گفتاری TTS، ضبط واقعی صدا و تنظیمات سیستمی",
  "main": "main.js",
  "license": "MIT",
  "author": {
    "name": "AVA"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pvwvuow/ava-voice-assistant.git"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ir.ava.assistant",
    "productName": "AVA Voice Assistant",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github"
    },
    "artifactName": "AVA-Setup-${version}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "آوا"
    }
  }
}
